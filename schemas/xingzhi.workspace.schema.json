{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://her-dock.local/schemas/xingzhi.workspace.schema.json",
  "title": "xingzhi.yml workspace config",
  "description": "Workspace-level Agent Workbench config. May only tighten org policy.",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string" },
    "defaultProvider": {
      "type": "string",
      "enum": ["codex", "claude", "grok"]
    },
    "defaultModel": { "type": "string" },
    "defaultKind": {
      "type": "string",
      "enum": ["coding", "analysis", "mixed"]
    },
    "autoExecute": {
      "type": "string",
      "enum": ["ask_always", "ask_risky", "auto_workspace", "auto_all"]
    },
    "rules": {
      "type": "array",
      "items": { "type": "string" }
    },
    "skills": {
      "type": "array",
      "items": { "type": "string" }
    },
    "writeAllow": {
      "type": "array",
      "items": { "type": "string" }
    },
    "analysis": {
      "type": "object",
      "properties": {
        "dataGlobs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "outputDir": { "type": "string" }
      }
    },
    "coding": {
      "type": "object",
      "properties": {
        "testCommand": { "type": "string" },
        "lintCommand": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}
